# Copy this file to .env and fill in your own values. .env is gitignored.

# Name of the local code-signing identity used to sign the built app.
# Create one via Keychain Access > Certificate Assistant > Create a
# Certificate > Code Signing (Identity Type: Self Signed Root), then set its
# Trust > Code Signing to "Always Trust". See README for details.
CODEXMETER_SIGN_IDENTITY="Your Signing Identity Name"
